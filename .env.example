# Copy to `.env.local` and set real values from Supabase → Project Settings → API.
# Until both lines below are replaced (not the placeholder text), portal/admin stay disabled.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL for Contact portfolio card (Vercel production domain). Falls back to
# VERCEL_* env on deploy, then https://your-name.vercel.app until set.
# NEXT_PUBLIC_SITE_URL=https://your-name.vercel.app

# Optional: only if documentation is hosted on another origin. Leave unset to use this app’s
# `/prodoc` URLs (same server). Example separate deploy: https://docs.example.com
# NEXT_PUBLIC_PRODOC_URL=

# Allow CORS POSTs to Next.js `/api/feedback` from doc page origins (match the host you use in the browser).
# Comma-separated. Example local:
PRODOC_ALLOWED_ORIGINS=http://localhost:3000

# After applying SQL: run 001, 002, then 003. Migration 003 allows anonymous read of
# feedback in ProFeed for public demo; without it, /profeed still loads for signed-in
# admin/customer but not for anonymous (RLS will block the query).

# Server-only: service role enables file uploads, edit/delete via edit_secret, and attachment cleanup.
# Also used by /api/storage/sign for anonymous "demo" download links on /profeed (path must exist
# in feedback_attachments). Without it, public visitors see file names only, not links.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ProDoc Assistant — server-only Gemini key (never expose via NEXT_PUBLIC_*).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# GitHub docs-as-code edit links (ProFeed "Edit on GitHub" for admin users).
NEXT_PUBLIC_GITHUB_DOCS_REPO=lingaraj-tw/prodoc
NEXT_PUBLIC_GITHUB_DOCS_BRANCH=main

# Contact form (Resend) — copy to .env.local; do not commit real keys.
# Sign up at https://resend.com (free tier). Use onboarding@resend.dev as CONTACT_FROM_EMAIL for testing.
# RESEND_API_KEY=your_resend_api_key_here
# CONTACT_EMAIL=lingaraj.m.tw@gmail.com
# CONTACT_FROM_EMAIL=contact@yourdomain.com
