# Copy to `.env.local` and set real values from Supabase → Project Settings → API.
# Until both lines below are replaced (not the placeholder text), portal/admin stay disabled.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ProDoc (Docusaurus) deployment URL (opened in a new tab from the portfolio home).
# In local dev, point this at your Docusaurus dev server (commonly http://localhost:3001).
NEXT_PUBLIC_PRODOC_URL=http://localhost:3001

# Allow CORS POSTs to Next.js `/api/feedback` from your ProDoc docs domain(s).
# Comma-separated list. Example for local dev:
PRODOC_ALLOWED_ORIGINS=http://localhost:3001

# Server-only: service role enables file uploads, edit/delete via edit_secret, and attachment cleanup.
# Without it, feedback still inserts (anon) but without attachments or returned edit links.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
